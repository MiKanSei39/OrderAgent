# 原 .env 保持不动。复制本文件为 .env.local 可覆盖项目配置；勿提交真实密钥。
LLM_PROVIDER=poke
LLM_MODEL=gpt-5.5
POKE_BASE_URL=https://www.poke2api.com/v1
# 不填 POKE_API_KEY 时继承系统环境变量中的密钥。
# POKE_API_KEY=你的密钥

# sqlite 为免部署演示模式；mysql 为课程数据库模式，不会静默回退。
STORAGE_BACKEND=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=你的数据库密码
# MYSQL_DATABASE=menu

# 课程完整服务：启动 compose 后填写；不填时为本地 FAQ/词法检索。
# REDIS_URL=redis://127.0.0.1:6379/0
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_TOKEN=
# EMBEDDING_MODEL=D:/path/to/bge-m3
AMAP_MCP_URL=https://mcp.api-inference.modelscope.net/fb589bc2bfcd49/mcp
AMAP_MCP_TRANSPORT=sse
AMAP_MCP_TOKEN=
API_HOST=127.0.0.1
API_PORT=18088
